---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';

const PERIODS = [
  ['7', '1W'], ['30', '1M'], ['90', '3M'], ['126', '6M'],
  ['ytd', 'YTD'], ['252', '1Y'], ['756', '3Y'], ['0', 'All'],
];
const TILES = [
  { id: 'advances', label: 'Advancing', note: 'Closed above yesterday' },
  { id: 'declines', label: 'Declining', note: 'Closed below yesterday' },
  { id: 'unchanged', label: 'Unchanged', note: 'Flat, or never traded' },
  { id: 'ratio', label: 'A / D ratio', note: 'Risers per faller · 1.00 is even' },
  { id: 'spread', label: 'Net spread', note: 'Risers minus fallers' },
  { id: 'mcclellan', label: 'McClellan', note: '19 less 39-day EMA of the spread' },
];
---
<Base title="Breadth & Momentum" current="breadth"
  description="A daily reading of the Jakarta Composite Index (IHSG) — market breadth, momentum and index price across the full IDX listing.">

  <div class="wrap">
    <header class="page-head">
      <div class="kicker">Breadth &amp; Momentum · <span id="universe-count">~950</span> stocks counted</div>
      <h1>How many rose, and how the index moved</h1>
      <p class="dek">Breadth counts how <em>many</em> stocks rose, not how far the index moved. Above 50% the advance is broad;
        below it, a handful of heavyweights carry the index while the rest retreat.</p>
    </header>

    <section class="hero" aria-label="Latest session">
      <div class="hero-lead">
        <div class="hero-label">% Advancing · <span id="hero-date">latest session</span></div>
        <div class="hero-figure" id="pct-advancing">—</div>
        <div class="hero-verdict" id="pct-verdict">Awaiting count</div>
        <dl class="hero-meta">
          <div><dt>20-day trend</dt><dd id="pct-advancing-ma">—</dd></div>
          <div><dt>On record</dt><dd><span id="pct-percentile">—</span> pctile</dd></div>
        </dl>
      </div>
      <div class="tiles">
        {TILES.map(t => (
          <div class="tile">
            <div class="tile-label">{t.label}</div>
            <div class="tile-value" id={t.id}>—</div>
            <svg class="tile-spark" id={`${t.id}-spark`} aria-hidden="true"></svg>
            <div class="tile-note">{t.note}</div>
          </div>
        ))}
      </div>
    </section>
  </div>

  <div class="toolbar">
    <div class="wrap">
      <span class="toolbar-label" id="period-label">Period</span>
      <div class="segmented" id="period" role="group" aria-labelledby="period-label">
        {PERIODS.map(([v, l]) => <button type="button" data-range={v} aria-pressed={v === '252' ? 'true' : 'false'}>{l}</button>)}
      </div>
    </div>
  </div>

  <div class="wrap">
    <Figure no="Fig. I" title="The index itself" chart="ihsg" size="tall"
      dek="The IHSG, one candle per session. It weighs each company by its freely traded value, so a few of the largest move it — beneath, the ones that did.">
      <div class="movers" id="movers" hidden>
        <div class="movers-head">
          <h3>Who moved it</h3>
          <div class="tabs" role="group" aria-label="Read one session or a date range">
            <button type="button" id="movers-mode-day" aria-pressed="true">One day</button>
            <button type="button" id="movers-mode-range" aria-pressed="false">Date range</button>
          </div>
          <span class="movers-pick" id="movers-pick-day">
            <button type="button" class="movers-btn" id="movers-prev" aria-label="Previous session">‹</button>
            <input type="date" class="movers-input" id="movers-day" aria-label="Session date">
            <button type="button" class="movers-btn" id="movers-next" aria-label="Next session">›</button>
          </span>
          <span class="movers-pick" id="movers-pick-range" hidden>
            <input type="date" class="movers-input" id="movers-from" aria-label="From date">
            <span class="movers-to">to</span>
            <input type="date" class="movers-input" id="movers-to" aria-label="To date">
          </span>
        </div>
        <div class="movers-title">
          <span class="movers-date" id="movers-date">—</span>
          <span class="movers-move" id="movers-move"></span>
        </div>
        <div class="movers-cols">
          <div class="movers-col up">
            <div class="movers-col-head">Lifted the index · points</div>
            <ol class="movers-list" id="movers-up"></ol>
          </div>
          <div class="movers-col down">
            <div class="movers-col-head">Dragged it · points</div>
            <ol class="movers-list" id="movers-down"></ol>
          </div>
        </div>
        <button type="button" class="link-btn" id="movers-more" hidden>Show 20</button>
        <p class="movers-foot" id="movers-foot"></p>
        <details class="how">
          <summary>How the attribution is estimated</summary>
          <p>Each stock's points are its weight going into the session times its own move. The weights are rebuilt
            from Yahoo share counts and public free-float figures refreshed monthly (latest
            <span id="movers-float-asof">—</span>), not IDX's own, so they can miss the real move by a few points — the
            gap is printed above. Stocks IDX flags for concentrated ownership no longer count toward the index from
            their effective date. A date range adds up each stock's points over its sessions, and shows its own price
            move across them. Covers the last year of sessions. Hover any candle to read that session.</p>
        </details>
      </div>
      <Fragment slot="how">
        <p>The body of each candle spans open to close, the wick the day's full range. Green closed up, red closed
          down. The breadth panels below check the index against everyone else.</p>
      </Fragment>
    </Figure>

    <Figure no="Fig. II" title="The breadth line" chart="adline"
      dek="The share of stocks that closed higher, one vote each — a bank worth billions and a micro-cap count the same. Above 50%, more rose than fell.">
      <Fragment slot="legend">
        <label class="legend-chip" style="color:#2f6b4f"><input type="checkbox" data-key="pctAdvancingMA" checked><span class="sw"></span><span>20-day</span></label>
        <label class="legend-chip" style="color:#a67a26"><input type="checkbox" data-key="pctAdvancingMA100" checked><span class="sw"></span><span>100-day</span></label>
        <label class="legend-chip" style="color:#3f5170"><input type="checkbox" data-key="pctAdvancingMA200" checked><span class="sw"></span><span>200-day</span></label>
        <label class="legend-chip" style="color:#8a8275"><input type="checkbox" data-key="daily" checked><span class="sw"></span><span>Daily</span></label>
      </Fragment>
      <Fragment slot="how">
        <p>Single sessions are noisy, so the faint dots are the raw daily readings and the lines are their 20, 100 and
          200-day averages. The 20-day line is green above the neutral 50% line and red below. Toggle a line off and
          the scale re-fits to what remains.</p>
      </Fragment>
    </Figure>

    <Figure no="Fig. III" title="The Zweig Breadth Thrust" chart="zbt">
      <Fragment slot="legend">
        <span class="legend-key"><span class="sw" style="background:#2f6b4f"></span>10-day EMA</span>
        <span class="legend-key"><span class="tri">▲</span>Jakarta trigger (56%)</span>
      </Fragment>
      <Fragment slot="dek">Was a bottom bought by the <em>whole</em> market? A climb from 40% to 56% (Jakarta rule) or 61.5%
        (Zweig) within ten sessions.</Fragment>
      <Fragment slot="how">
        <p>Zweig's 61.5% bar has been cleared <span id="zbt-count">—</span> (peak <span id="zbt-record">—</span>). The
          ▲ marks the looser Jakarta rule, 56%: <span id="idx-count">—</span>. Six months later the IHSG averaged
          <span id="idx-after">—</span>, against <span id="idx-base">—</span> on an ordinary day; SPY after Zweig's own
          triggers, +17.3% against +6.3% (2009–2025). Most Jakarta episodes predate 2014, so read it as a level to
          watch, not a proven signal.</p>
      </Fragment>
    </Figure>
  </div>

  <div class="wrap">
    <div class="figure-grid">
      <Figure no="Fig. IV" title="Momentum — Stochastic" chart="stoch" size="short"
        dek="Where this week's close sits in the last fifteen weeks' range. Below 20 oversold, above 80 overbought.">
        <Fragment slot="legend">
          <span class="legend-key"><span class="sw" style="background:#1a1714"></span>%K</span>
          <span class="legend-key"><span class="sw" style="background:#3f5170"></span>%D</span>
        </Fragment>
        <Fragment slot="how">
          <p>100% means the week finished at the top of its fifteen-week range, 0% at the bottom. %K is the raw
            reading, %D its three-week average. This one tracks <em>price</em>, not breadth, and runs on weekly bars,
            so it needs a long reading period to say anything.</p>
        </Fragment>
      </Figure>
      <Figure no="Fig. V" title="Shinohara intensity" chart="shinohara" size="short"
        dek="Weak minus Strong over 26 weeks (Yahoo's formula). Above 100 — shaded — is extremely oversold.">
        <Fragment slot="how">
          <p>Shinohara measures buying and selling pressure as two ratios; the reading is the <em>gap</em> between
            them, so the gap itself is plotted. A reading above 100 is rare and historically bullish.</p>
        </Fragment>
      </Figure>
    </div>

    <section class="figure" aria-labelledby="record-title">
      <div class="figure-head">
        <span class="figure-no">Tab. A</span>
        <h2 id="record-title">The daily record</h2>
      </div>
      <p class="figure-dek">Every reading above, one row per session. Click a heading to sort; search reaches the whole record, not just the period.</p>
      <div class="table-tools">
        <input type="search" id="date-filter" class="search" placeholder="Find a session — 2019, 2026-03…" aria-label="Filter the daily record by date">
        <span class="table-count" id="record-count"></span>
      </div>
      <div class="table-wrap">
        <table id="data-table" class="data-table">
          <thead></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="table-more"><button type="button" class="btn" id="record-more" hidden>Show all</button></div>
    </section>
  </div>

  <script src="../lib/breadth.js"></script>
</Base>
